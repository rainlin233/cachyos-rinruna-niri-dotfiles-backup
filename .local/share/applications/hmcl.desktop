[Desktop Entry]
# 应用程序类型（固定为 Application）
Type=Application

# 应用程序名称（应用菜单中显示的名称）
Name=HMCL

# 鼠标悬停时显示的提示文本（可选）
Comment=Hello Minecraft! Launcher

# 启动命令（脚本在 $PATH 中，直接写名字即可；选最新版逻辑在脚本内部）
Exec=hmcl-launcher %U

# 指定应用程序图标（图标主题中的名称，无需写路径）
Icon=hmcl

# 是否在终端窗口中运行（GUI 程序填 false，CLI 命令行程序填 true）
Terminal=false

# 应用分类（决定在菜单中的归类，用分号隔开）
Categories=Game;

# 搜索关键词（可选，方便在启动器中模糊搜索）
Keywords=hmcl;mc;minecraft;
